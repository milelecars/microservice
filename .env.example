# ── Telegram (@FounderCircleAdminBot) ─────────────────────────────────────────
BOT_TOKEN=7123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Founder Circle channel — numeric id, starts with -100
# To get it: forward a message from the channel to @userinfobot
CHANNEL_ID=-1001234567890

# Invite link shown on the "Join Founder Circle" button
CHANNEL_INVITE_LINK=https://t.me/+PSbwbTVOCeU0NWJk

# Public base URL of this service (used by `npm run set-webhook`)
PUBLIC_URL=https://kommo-verify-production.up.railway.app

# ── Kommo ─────────────────────────────────────────────────────────────────────
# Long-lived access token for the fahadriazex1 account
KOMMO_TOKEN=your_kommo_long_lived_token

# Kommo's Telegram hook for the SAME bot as BOT_TOKEN — Telegram updates are
# forwarded here so the Salesbot sees them. The URL contains the bot token,
# so it is a secret: never commit or log it.
KOMMO_TG_WEBHOOK=https://amojo.amocrm.com/~external/hooks/telegram?t=7123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx&

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your_service_role_key

# ── Weex Affiliate API ─────────────────────────────────────────────────────────
WEEX_API_KEY=your_weex_api_key_here
WEEX_SECRET_KEY=your_weex_secret_key_here
WEEX_PASSPHRASE=your_weex_passphrase_here

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
